# ============================================================
# Sales Rep RAG Agent — environment variables
# Copy this file to .env and fill in your values.
# All variables are optional; defaults are shown below.
# ============================================================

# ---- Ollama (local LLM) ------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
# OLLAMA_MODEL=qwen2.5:7b

# ---- OpenAI (consult_oracle higher-intelligence tool) ------
# Paste your OpenAI API key here.
# The oracle is called when the local model has gathered enough
# facts but needs help synthesising a sharp value hypothesis.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ---- RAG / Embeddings --------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Use Ollama embeddings instead (requires a pulled embedding model):
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- Vector store ------------------------------------------
VECTOR_STORE_TYPE=memory
# For persistent storage across runs, use chroma:
# VECTOR_STORE_TYPE=chroma
# VECTOR_STORE_PATH=./chroma_sales_rep

# ---- Chunking & retrieval ----------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVER_TOP_K=8

# ---- Agent loop --------------------------------------------
MAX_STEPS=6
MIN_CONFIDENCE_TO_STOP=0.6

# ---- LangGraph ---------------------------------------------
# ENABLE_CHECKPOINTING=1
# GRAPH_RECURSION_LIMIT=80
